# Variables for `docker compose up`. Copy to .env and fill in.
# (For running the API outside Docker, see apps/api/.env.example.)

# Required: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=

# Optional: real AI responses. Without it the AI features run in a labelled demo mode.
GEMINI_API_KEY=

# Optional: "Continue with GitHub/Google". Callback URLs to register with the provider:
#   ${PUBLIC_URL}/api/v1/auth/oauth/github/callback
#   ${PUBLIC_URL}/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: real SMTP. By default mail goes to the bundled Mailpit (http://localhost:8025).
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=DevHub+ <no-reply@example.com>

# Shared secret between the API and the sandboxed code runner (any long random string)
RUNNER_TOKEN=

# Optional overrides
POSTGRES_PASSWORD=devhub
PUBLIC_URL=http://localhost:8080
# Set to true when serving over HTTPS
COOKIE_SECURE=false
# Load demo users, questions, snippets and sessions on first start
SEED_DEMO_DATA=true
