# DevHub+ AWS EC2 deployment — copy to .env.aws and fill in values
# Postgres runs as a local container (not Aurora)
POSTGRES_PASSWORD=devhub

# Auth
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48

# Public URL (Caddy serves HTTPS on this subdomain)
PUBLIC_URL=https://devhub.3-109-36-90.sslip.io
CORS_ORIGINS=https://devhub.3-109-36-90.sslip.io

# Email (optional)
SMTP_URL=
MAIL_FROM=DevHub+ <no-reply@devhub.dev>

# AI provider: 'bedrock' (uses EC2 IAM role, no key needed) or 'gemini' (needs API key)
AI_PROVIDER=bedrock
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=openai.gpt-oss-120b-1:0
BEDROCK_FALLBACK_MODEL=qwen.qwen3-32b-v1:0

# Gemini (only needed if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Runner
RUNNER_TOKEN=devhub-runner-prod-token

# Port
PORT=4000
