# DevHub+ API configuration. Copy to .env and adjust. All values are validated at startup
# (src/config/env.ts): the server refuses to boot with a missing or weak secret.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL 14+ (docker compose up -d postgres gives you this URL)
DATABASE_URL="postgresql://devhub:devhub@localhost:5432/devhub?schema=public"

# Optional. Enables shared cache/rate limits and multi-instance Socket.IO.
# Without it the API runs single-instance with in-memory equivalents.
REDIS_URL="redis://localhost:6379"

# Comma-separated browser origins allowed by CORS and Socket.IO
CORS_ORIGINS="http://localhost:5173"

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET="change-me-to-at-least-32-random-characters-please"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
# Set COOKIE_SECURE=true when serving over HTTPS (default: true in production)
# COOKIE_SECURE=true
# Number of reverse proxies in front of the API (for correct client IPs in rate limits)
TRUST_PROXY=0

# Google Gemini. Without a key the AI features run in a clearly-labelled demo mode.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
AI_TIMEOUT_MS=45000
AI_REQUESTS_PER_HOUR=30

# Local E2E/load testing only (refused when NODE_ENV=production)
# RATE_LIMITS_ENABLED=false
