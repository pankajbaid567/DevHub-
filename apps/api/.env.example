# DevHub+ API configuration. Copy to .env and adjust. All values are validated at startup
# (src/config/env.ts): the server refuses to boot with a missing or weak secret.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL 14+ (docker compose up -d postgres gives you this URL)
DATABASE_URL="postgresql://devhub:devhub@localhost:5432/devhub?schema=public"

# Optional. Enables shared cache/rate limits and multi-instance Socket.IO.
# Without it the API runs single-instance with in-memory equivalents.
REDIS_URL="redis://localhost:6379"

# Comma-separated browser origins allowed by CORS and Socket.IO
CORS_ORIGINS="http://localhost:5173"

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET="change-me-to-at-least-32-random-characters-please"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
# Set COOKIE_SECURE=true when serving over HTTPS (default: true in production)
# COOKIE_SECURE=true
# Number of reverse proxies in front of the API (for correct client IPs in rate limits)
TRUST_PROXY=0

# Google Gemini. Without a key the AI features run in a clearly-labelled demo mode.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=45000
AI_REQUESTS_PER_HOUR=30

# WebRTC calls: STUN works for most networks; add a TURN relay (e.g. coturn) for strict NATs
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Web app origin, used in email links and OAuth redirects (default: first CORS origin)
# PUBLIC_URL=http://localhost:5173

# Email. Unset: emails are logged instead of sent. `docker compose up -d mailpit` gives you
# a local inbox at http://localhost:8025 with this URL:
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="DevHub+ <no-reply@devhub.dev>"

# Background jobs (BullMQ when REDIS_URL is set). Set false on replicas that should only
# serve HTTP; at least one replica must consume jobs.
# WORKER_ENABLED=true

# "Continue with GitHub/Google" (optional). Register the callback URL
#   ${PUBLIC_URL}/api/v1/auth/oauth/<github|google>/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sandboxed code runner (apps/runner). Start it with:
#   RUNNER_TOKEN=local-dev-runner-token-123 npm run dev -w @devhub/runner
# CODE_RUNNER_URL=http://localhost:2000
# RUNNER_TOKEN=local-dev-runner-token-123

# Local E2E/load testing only (refused when NODE_ENV=production)
# RATE_LIMITS_ENABLED=false
