// DevHub+ data model. See docs/ARCHITECTURE.md ("Data model") for the reasoning behind
// denormalised counters, the reputation ledger and the index choices.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum SessionMode {
  PAIRING
  INTERVIEW
}

enum Recommendation {
  STRONG_NO
  NO
  YES
  STRONG_YES
}

/// Declaration order is the sort order (LIVE first) used by session listings.
enum SessionStatus {
  LIVE
  SCHEDULED
  ENDED
}

enum SessionVisibility {
  PUBLIC
  PRIVATE
}

enum ParticipantRole {
  HOST
  EDITOR
  VIEWER
}

enum VoteTarget {
  QUESTION
  ANSWER
}

enum ReputationReason {
  QUESTION_VOTE
  ANSWER_VOTE
  ANSWER_ACCEPTED
  DOWNVOTE_CAST
}

enum NotificationType {
  ANSWER_POSTED
  ANSWER_ACCEPTED
  CONTENT_UPVOTED
  SNIPPET_STARRED
  SESSION_STARTED
  SESSION_REMINDER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum MentorRole {
  user
  assistant
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique // stored lowercase
  email              String    @unique // stored lowercase
  /// Null for accounts created through GitHub/Google sign-in that never set a password.
  passwordHash       String?
  emailVerifiedAt    DateTime?
  /// TOTP second factor: AES-GCM sealed secret, set once confirmed with a valid code.
  totpSecret         String?
  totpPendingSecret  String?
  totpEnabledAt      DateTime?
  /// Last accepted time step: a code can never be used twice.
  totpLastStep       Int?
  emailNotifications Boolean   @default(true)
  displayName        String?
  bio                String?
  avatarUrl          String?
  reputation         Int       @default(0) // cached sum of ReputationEvent.delta
  role               Role      @default(USER)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  questions           Question[]
  answers             Answer[]
  votes               Vote[]
  snippets            Snippet[]
  stars               SnippetStar[]
  hostedSessions      Session[]            @relation("SessionHost")
  participations      SessionParticipant[]
  messages            Message[]
  notifications       Notification[]       @relation("NotificationRecipient")
  actedNotifications  Notification[]       @relation("NotificationActor")
  reputationEvents    ReputationEvent[]
  skills              SkillRating[]
  mentorConversations MentorConversation[]
  resumeReviews       ResumeReview[]
  codeRuns            CodeRun[]
  oauthAccounts       OAuthAccount[]
  emailTokens         EmailToken[]
  recoveryCodes       RecoveryCode[]
  reports             Report[]             @relation("Reporter")
  resolvedReports     Report[]             @relation("Resolver")
  scorecards          InterviewScorecard[] @relation("ScorecardAuthor")
  interviewFeedback   InterviewFeedback[]

  @@index([reputation(sort: Desc)])
  @@map("users")
}

/// Rotating refresh tokens. Only a SHA-256 hash is stored. Tokens of one login share a
/// familyId; presenting a revoked token revokes the whole family (reuse detection).
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// A linked GitHub/Google identity. One external account maps to exactly one user.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "github" | "google"
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Single-use email links (verification, password reset). Only a SHA-256 hash is stored.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// Transactional outbox: a job is written in the same transaction as the change that
/// causes it, then relayed to the queue. No "row committed but email lost" window.
model OutboxEvent {
  id           String    @id @default(cuid())
  topic        String
  payload      Json
  availableAt  DateTime  @default(now())
  dispatchedAt DateTime?
  /// Lease: a relay claimed the row until then (or it is backing off after a failure).
  lockedUntil  DateTime?
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())

  @@index([dispatchedAt, availableAt])
  @@map("outbox")
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  questions Question[]
  snippets  Snippet[]
  sessions  Session[]

  @@map("tags")
}

model Question {
  id               String                   @id @default(cuid())
  title            String
  body             String
  score            Int                      @default(0) // denormalised sum of votes
  answerCount      Int                      @default(0)
  viewCount        Int                      @default(0)
  acceptedAnswerId String?                  @unique
  authorId         String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  lastActivityAt   DateTime                 @default(now())
  /// Maintained by a database trigger (see migration "init"): weighted title + body.
  searchVector     Unsupported("tsvector")?

  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  acceptedAnswer Answer?  @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  answers        Answer[] @relation("QuestionAnswers")
  tags           Tag[]
  votes          Vote[]

  @@index([createdAt(sort: Desc)])
  @@index([score(sort: Desc)])
  @@index([lastActivityAt(sort: Desc)])
  @@index([authorId])
  @@index([searchVector], type: Gin)
  @@map("questions")
}

model Answer {
  id         String   @id @default(cuid())
  body       String
  score      Int      @default(0)
  questionId String
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question   Question  @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  acceptedOn Question? @relation("AcceptedAnswer")
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes      Vote[]

  @@index([questionId, score(sort: Desc)])
  @@index([authorId])
  @@map("answers")
}

/// One row per (user, target). Exactly one of questionId / answerId is set
/// (enforced by a CHECK constraint in the migration).
model Vote {
  id         String     @id @default(cuid())
  userId     String
  target     VoteTarget
  questionId String?
  answerId   String?
  value      Int // +1 or -1; retracting deletes the row
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@unique([userId, answerId])
  @@map("votes")
}

/// Append-only ledger: every reputation change with its reason. User.reputation is the cache.
model ReputationEvent {
  id        String           @id @default(cuid())
  userId    String
  delta     Int
  reason    ReputationReason
  refId     String? // question / answer id that caused it
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("reputation_events")
}

model Snippet {
  id           String                   @id @default(cuid())
  title        String
  description  String                   @default("")
  code         String
  language     String
  visibility   Visibility               @default(PUBLIC)
  starCount    Int                      @default(0)
  forkCount    Int                      @default(0)
  forkedFromId String?
  authorId     String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  /// Maintained by a database trigger: weighted title + description + tags-free code excerpt.
  searchVector Unsupported("tsvector")?

  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  forkedFrom Snippet?      @relation("Forks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks      Snippet[]     @relation("Forks")
  tags       Tag[]
  stars      SnippetStar[]

  @@index([visibility, createdAt(sort: Desc)])
  @@index([visibility, starCount(sort: Desc)])
  @@index([authorId])
  @@index([language])
  @@index([searchVector], type: Gin)
  @@map("snippets")
}

model SnippetStar {
  userId    String
  snippetId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippet   Snippet  @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@id([userId, snippetId])
  @@index([snippetId])
  @@map("snippet_stars")
}

model Session {
  id              String            @id @default(cuid())
  title           String
  description     String            @default("")
  language        String            @default("javascript")
  mode            SessionMode       @default(PAIRING)
  status          SessionStatus     @default(SCHEDULED)
  visibility      SessionVisibility @default(PUBLIC)
  inviteCode      String?           @unique
  maxParticipants Int               @default(10)
  code            String            @default("") // plain-text snapshot of the shared document
  docState        Bytes? // Yjs CRDT state (Y.encodeStateAsUpdate)
  scheduledFor    DateTime?
  /// Set atomically by the reminder job so a re-delivered job cannot remind twice.
  reminderSentAt  DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  hostId          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Interview mode (null for pairing sessions). The problem is a snapshot, so editing the
  // bank never changes a past interview.
  problemSlug        String?
  problemTitle       String?
  problemStatement   String?
  durationMinutes    Int?
  interviewStartedAt DateTime?
  interviewEndsAt    DateTime?
  interviewEndedAt   DateTime?

  host         User                 @relation("SessionHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants SessionParticipant[]
  messages     Message[]
  tags         Tag[]
  runs         CodeRun[]
  updates      SessionUpdate[]
  scorecards   InterviewScorecard[]
  feedback     InterviewFeedback[]

  @@index([visibility, status, createdAt(sort: Desc)])
  @@index([hostId])
  @@map("sessions")
}

model SessionParticipant {
  sessionId String
  userId    String
  role      ParticipantRole @default(EDITOR)
  joinedAt  DateTime        @default(now())
  session   Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
  @@map("session_participants")
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  message   String
  link      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model SkillRating {
  userId    String
  name      String
  rating    Int
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, name])
  @@map("skill_ratings")
}

model MentorConversation {
  id        String          @id @default(cuid())
  userId    String
  topic     String          @default("general")
  title     String          @default("New conversation")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  MentorMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("mentor_conversations")
}

model MentorMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           MentorRole
  content        String
  model          String?
  /// Citations (CitationDto[]) from retrieval-augmented replies.
  sources        Json?
  createdAt      DateTime           @default(now())
  conversation   MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("mentor_messages")
}

model ResumeReview {
  id         String   @id @default(cuid())
  userId     String
  fileName   String?
  targetRole String?
  result     Json
  model      String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_reviews")
}

/// Semantic-search index (pgvector). One row per chunk of a question, answer or snippet.
/// The HNSW index (cosine) is created in the migration: Prisma cannot express it.
model ContentEmbedding {
  id          String                     @id @default(cuid())
  kind        String // "question" | "answer" | "snippet"
  refId       String
  chunk       Int                        @default(0)
  /// For answers: the question they belong to (citations link there).
  questionId  String?
  content     String
  contentHash String
  model       String
  embedding   Unsupported("vector(768)")
  updatedAt   DateTime                   @updatedAt

  @@unique([kind, refId, chunk])
  @@index([kind, model])
  @@map("content_embeddings")
}

/// A sandboxed execution in a session (history shared with every participant).
model CodeRun {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  language   String
  code       String
  stdin      String?
  status     String // ok | error | timeout | output_limit | failed
  stdout     String
  stderr     String
  exitCode   Int?
  durationMs Int
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)])
  @@map("code_runs")
}

/// Append-only edit log for session replay: each row is the effective Yjs diff of one edit
/// (or a baseline snapshot when a document is first recorded). Applying rows in id order
/// reconstructs the code and whiteboard at any moment.
model SessionUpdate {
  id        BigInt   @id @default(autoincrement())
  sessionId String
  userId    String?
  update    Bytes
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
  @@map("session_updates")
}

/// Single-use 2FA recovery codes (SHA-256 only).
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

/// A user's report of a question, answer or snippet. One report per user per item.
/// `aiTriage` holds the validated AI verdict used to prioritise the admin queue.
model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   String // QUESTION | ANSWER | SNIPPET
  targetId     String
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  aiTriage     Json?
  resolvedById String?
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?        @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, targetType, targetId])
  @@map("reports")
}

/// The interviewer's private notes and ratings. Never broadcast; readable only by its author.
model InterviewScorecard {
  sessionId      String
  interviewerId  String
  notes          String          @default("")
  ratings        Json            @default("{}")
  recommendation Recommendation?
  updatedAt      DateTime        @updatedAt

  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  interviewer User    @relation("ScorecardAuthor", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@id([sessionId, interviewerId])
  @@map("interview_scorecards")
}

/// AI feedback on a practice interview with the voice interviewer. Visible to its owner only.
model InterviewFeedback {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  transcript Json
  code       String   @default("")
  feedback   Json
  model      String
  createdAt  DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("interview_feedback")
}
