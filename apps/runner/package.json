{
  "name": "@devhub/runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sandboxed code execution service for DevHub+ sessions (no dependencies; isolation comes from the container plus per-run limits).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
